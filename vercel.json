{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "server": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/health", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
  {
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@napi-rs/canvas/**"
    }
  }
}
}